<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.geometry.Pos?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<GridPane fx:id="rootPane" prefHeight="100.0" prefWidth="400.0"
          style="-fx-border-color: black; -fx-padding: 10; -fx-hgap: 10; -fx-vgap: 10;"
          alignment="CENTER"
          xmlns="http://javafx.com/javafx/23.0.1"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="uz.tenzorsoft.scaleapplication.ui.ButtonController">

  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS"/>
    <ColumnConstraints hgrow="ALWAYS"/>
  </columnConstraints>

  <rowConstraints>
    <RowConstraints vgrow="NEVER"/> <!-- Title -->
    <RowConstraints vgrow="ALWAYS"/> <!-- 1-shlagbaum -->
    <RowConstraints vgrow="ALWAYS"/> <!-- 2-shlagbaum -->
  </rowConstraints>

  <Text text="Qo'lda boshqarish (Chiqish)" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"
        textAlignment="CENTER" GridPane.halignment="CENTER">
    <font>
      <Font size="16.0"/>
    </font>
  </Text>

  <Button fx:id="button1" mnemonicParsing="false" onMouseClicked="#openGate1Manually"
          style="-fx-font-size: 1.2em; -fx-background-color: #64ff4b; -fx-border-color: black; -fx-border-radius: 7;
                 -fx-background-radius: 10; -fx-border-width: 0.8; -fx-alignment: center;"
          text="1-shlagbaumni ochish" maxWidth="Infinity" prefHeight="35"
          GridPane.columnIndex="0" GridPane.rowIndex="1">
    <cursor>
      <Cursor fx:constant="HAND"/>
    </cursor>
  </Button>

  <Button fx:id="button5" mnemonicParsing="false" onMouseClicked="#closeGate1"
          style="-fx-font-size: 1.2em; -fx-background-color: #ff3d3d; -fx-border-color: black; -fx-border-radius: 7;
                 -fx-background-radius: 10; -fx-border-width: 0.8; -fx-alignment: center;"
          text="1-shlagbaumni yopish" maxWidth="Infinity" prefHeight="35"
          GridPane.columnIndex="1" GridPane.rowIndex="1">
    <cursor>
      <Cursor fx:constant="HAND"/>
    </cursor>
  </Button>

  <Button fx:id="button2" mnemonicParsing="false" onMouseClicked="#openGate2Manually"
          style="-fx-font-size: 1.2em; -fx-background-color: #64ff4b; -fx-border-color: black; -fx-border-radius: 7;
                 -fx-background-radius: 10; -fx-border-width: 0.8; -fx-alignment: center;"
          text="2-shlagbaumni ochish" maxWidth="Infinity" prefHeight="35"
          GridPane.columnIndex="0" GridPane.rowIndex="2">
    <cursor>
      <Cursor fx:constant="HAND"/>
    </cursor>
  </Button>

  <Button fx:id="button4" mnemonicParsing="false" onMouseClicked="#closeGate2"
          style="-fx-font-size: 1.2em; -fx-background-color: #ff3d3d; -fx-border-color: black; -fx-border-radius: 7;
                 -fx-background-radius: 10; -fx-border-width: 0.8; -fx-alignment: center;"
          text="2-shlagbaumni yopish" maxWidth="Infinity" prefHeight="35"
          GridPane.columnIndex="1" GridPane.rowIndex="2">
    <cursor>
      <Cursor fx:constant="HAND"/>
    </cursor>
  </Button>
</GridPane>
